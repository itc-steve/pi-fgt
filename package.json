{
  "name": "@itc-steve/pi-fgt",
  "version": "1.3.0",
  "description": "Pi extension: read-only multi-device FortiGate (FortiOS REST) tools — firewall, VPN, FortiAP, FortiSwitch",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "fortigate",
    "fortios",
    "firewall"
  ],
  "author": {
    "name": "itc-steve",
    "url": "https://github.com/itc-steve"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itc-steve/pi-fgt.git"
  },
  "bugs": {
    "url": "https://github.com/itc-steve/pi-fgt/issues"
  },
  "homepage": "https://github.com/itc-steve/pi-fgt#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "src",
    "types",
    "fortigate.json.example",
    "fortigate.env.example",
    "fortigate-filters.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "filters:example": "node --experimental-strip-types scripts/gen-filters-example.ts",
    "test:filters": "node --experimental-strip-types src/filters/engine.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "typebox": "^1.3.6",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
